# ============================================================
# video-upscaler-api configuration
# Copy to `.env` and adjust for the machine that runs the renders.
# ============================================================

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Directories (Windows paths are normalized automatically)
TEMP_DIR=D:\VideoTemp
OUTPUT_DIR=D:\Hasil Render

# Topaz Video AI binaries (never the system ffmpeg/ffprobe)
FFMPEG_PATH=C:\Program Files\Topaz Labs LLC\Topaz Video AI\ffmpeg.exe
FFPROBE_PATH=C:\Program Files\Topaz Labs LLC\Topaz Video AI\ffprobe.exe

# Upload limits (50 GiB) and accepted dimensions
MAX_UPLOAD_SIZE_BYTES=53687091200
MIN_DIMENSION=16
MAX_DIMENSION=7680
# H.264 yuv420p requires even dimensions
ENFORCE_EVEN_DIMENSIONS=true
ALLOWED_VIDEO_EXTENSIONS=mp4,mkv,mov,webm,m4v,avi,mpg,mpeg,ts,m2ts

# Runtime state (SQLite database, logs). Defaults to ./data and ./logs
# DATA_DIR=D:\video-upscaler-api\data
# LOGS_DIR=D:\video-upscaler-api\logs

# Queue (fixed at 1: a single GPU renderer)
QUEUE_CONCURRENCY=1

# Job retention / cleanup
JOB_RETENTION_HOURS=72
FAILED_JOB_RETENTION_HOURS=24
TEMP_STALE_HOURS=24
CLEANUP_INTERVAL_MS=1800000
RECONCILE_INTERVAL_MS=30000

# Progress: at most one SQLite write per interval
PROGRESS_PERSIST_INTERVAL_MS=500
FFMPEG_STDERR_TAIL_BYTES=16384

# Renderer validation
REQUIRE_NVENC=true
RENDERER_SELFTEST=true
RENDERER_MODEL_SELFTEST=true
RENDERER_RECHECK_COOLDOWN_MS=60000
ALLOW_DEGRADED_START=false

# Refuse to start a second instance while another one owns the GPU
SINGLE_INSTANCE=true
# Process name checked before a leftover pid from a crash is force-killed
RENDERER_PROCESS_NAME=ffmpeg

# Renderer parameters kept from the Topaz baseline
TOPAZ_MODEL=prob-3
# auto = copy mp4-safe audio, re-encode anything else (vorbis/pcm) to aac
AUDIO_MODE=auto

# Lifecycle
SHUTDOWN_POLICY=terminate
SHUTDOWN_TIMEOUT_MS=15000
KILL_GRACE_MS=5000

# HTTP (0 = no request timeout, required for multi-hour uploads)
HTTP_REQUEST_TIMEOUT_MS=0
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
HTTP_HEADERS_TIMEOUT_MS=66000
JSON_BODY_LIMIT=100kb
# CORS_ORIGIN=* or a comma separated allowlist, e.g. http://localhost:5173
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info
LOG_TO_FILE=false
